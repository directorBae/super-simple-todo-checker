{
  "name": "todo-checklist",
  "productName": "할 일 체커",
  "version": "1.1.4",
  "description": "팀/프로젝트 기반 메모형 할 일 체커",
  "author": "baejungwon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -s first \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 node scripts/launch-electron.cjs\"",
    "build": "vite build",
    "test:ui": "npm run build && node scripts/run-ui-smoke.cjs",
    "start": "npm run build && node scripts/launch-electron.cjs",
    "dist": "vite build && electron-builder --win",
    "dist:demo": "vite build && electron-builder --win --config electron-builder.demo.cjs --publish never",
    "dist:mac": "vite build && electron-builder --mac",
    "release": "vite build && electron-builder --win --publish always"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.baejungwon.todo-checklist",
    "productName": "할 일 체커",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/**",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon-1024.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "할 일 체커",
      "artifactName": "todo-checker-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "directorBae",
        "repo": "super-simple-todo-checker"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon-1024.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "artifactName": "todo-checker-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
