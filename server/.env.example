# 개인 PC에서 실행할 때의 기본 설정
PORT=8787
PUBLIC_URL=http://localhost:8787
TIME_ZONE=Asia/Seoul

# 비워두면 data/token.txt에 서버 토큰을 생성합니다.
SYNC_TOKEN=

# 모바일에서 PC 앱 없이 로그인할 개인 서버 비밀번호 (12자 이상).
# 비워두면 data/login-password.txt에 비밀번호를 자동 생성합니다.
PERSONAL_PASSWORD=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Cloud: 웹 애플리케이션 OAuth 클라이언트
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 선택: Notion 공개 연결 OAuth. 내부 연결 토큰은 앱에 입력합니다.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# 선택: 로컬 credentials.key 대신 사용할 32바이트 base64 암호화 키
# CREDENTIAL_KEY=

# Docker + Caddy로 HTTPS를 설정할 때만 사용
SYNC_DOMAIN=todo.example.com
SYNC_EMAIL=you@example.com
